# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/external_fuse

# Coinbase Developer Platform (CDP) credentials for x402 payment verification
CDP_API_KEY_ID=your-cdp-api-key-id
CDP_API_KEY_SECRET=-----BEGIN EC PRIVATE KEY-----\nyour-key-here\n-----END EC PRIVATE KEY-----

# Wallet address to receive payments (defaults to project wallet if unset)
WALLET_ADDRESS=0x60c402878EfcEcAe5733A88075328Aa2320C39BE

# Embedded facilitator fallback (only needed if CDP credentials are not set)
FACILITATOR_PRIVATE_KEY=
BASE_RPC_URL=https://mainnet.base.org

# Set to true to bypass real payment verification during local testing
TEST_MODE=false
